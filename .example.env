# =============================================================================
# OpReady — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values before starting the app.
# Variables marked REQUIRED will cause the server to abort on startup if missing
# (in production mode). All other variables have safe defaults.
# =============================================================================


# =============================================================================
# APPLICATION SECURITY  (REQUIRED in production)
# =============================================================================

# Superadmin login credentials. These credentials log in to the built-in
# superadmin account that cannot be deleted from the UI.
APP_USERNAME=admin
APP_PASSWORD=your_secure_production_password

# Secret used to sign and verify session cookies.
# REQUIRED in production — startup aborts if missing or blank.
# Generate a strong value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_a_long_random_string_32_chars_minimum

# HMAC secret used to hash stored API keys (H-16 hardening).
# If unset, falls back to SESSION_SECRET. Generate independently for defence-in-depth:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: Changing this secret invalidates all existing API keys — they must be regenerated.
# API_KEY_HASH_SECRET=

# Maximum consecutive failed login attempts before an account is locked
# and an alert email is sent to SMTP_USER. (default: 5)
MAX_LOGIN_ATTEMPTS=5

# Whether session cookies are sent only over HTTPS.
# Set to 'false' for local HTTP development.
# Leave unset or set to 'true' in production — your deployment must sit behind
# a TLS-terminating reverse proxy (Cloudflare Tunnel, nginx, etc.).
# (default: true)
COOKIE_SECURE=true

# Allowed origin for Socket.IO cross-origin connections.
# Leave unset for the standard same-origin deployment where the browser,
# the API, and the WebSocket all share the same hostname and port.
# Only set this if your frontend is served from a separate domain, e.g.:
# CORS_ORIGIN=https://app.yourdomain.com


# =============================================================================
# OPERATION MODE
# =============================================================================

# Controls which data source is used and whether demo restrictions apply.
#   production  — live OI dashboard scraping via NZ proxy (default)
#   demo        — sandboxed mode using a bundled static file; all destructive
#                 actions are blocked; demo credentials below are used
APP_MODE=production

# Deployment platform — controls whether the Scheduled Backup feature is available.
# On ephemeral platforms the app may be scaled to zero between requests, so a
# server-side cron job cannot be guaranteed to fire on schedule.
#   local       — running on a local machine or persistent VM (default)
#   vm          — cloud virtual machine (EC2, GCE, Azure VM, etc.) — always-on
#   cloud-run   — Google Cloud Run (ephemeral) — scheduled backup DISABLED
#   app-runner  — AWS App Runner (ephemeral)   — scheduled backup DISABLED
#   fargate     — AWS Fargate (ephemeral)       — scheduled backup DISABLED
# (default: local)
DEPLOYMENT_TYPE=local


# =============================================================================
# DEMO MODE  (only used when APP_MODE=demo)
# =============================================================================

DEMO_SUPERADMIN_USERNAME=demo_admin
DEMO_SUPERADMIN_PASSWORD=demo_pass


# =============================================================================
# SERVER
# =============================================================================

# Public base URL of this deployment — used when building links in outbound emails
# (e.g. password reset links). Include the scheme and host, no trailing slash.
# If unset, the URL is derived automatically from the incoming request, which works
# correctly for most deployments but will produce the wrong hostname when the app
# sits behind a custom domain on Cloud Run, App Runner, or a reverse proxy.
# Example: https://opready.yourbrigade.nz
# APP_BASE_URL=

# Port the HTTP server listens on. (default: 3000)
# PORT=3000

# Node.js environment. Controls log format: 'production' emits JSON;
# any other value (e.g. 'development') emits colourised human-readable text.
# (default: development)
# NODE_ENV=production


# =============================================================================
# LOGGING
# =============================================================================

# Minimum log level emitted to stdout.
# Options (least → most verbose): error | warn | info | debug
# (default: info)
# LOG_LEVEL=info


# =============================================================================
# EXTRACTION ENGINE
# =============================================================================

# Selects which ETL plugin is used to fetch member skill expiry data.
# Each plugin implements the same output contract so the rest of the application
# is unaffected when switching plugins.
#
#   html-scraper  — scrapes the OI HTML dashboard page (default)
#   rest-api      — fetches from a REST API endpoint (stub, not yet implemented)
#
# To add a new source: create services/plugins/<name>.plugin.js and set this value.
# (default: html-scraper)
EXTRACTION_PLUGIN=html-scraper


# =============================================================================
# OSM DASHBOARD CONNECTION  (html-scraper plugin)
# =============================================================================

# Your brigade's Business Unit GUID from the OSM dashboard URL.
# The scraper builds the full URL automatically from this value.
# Required unless you set DASHBOARD_URL manually (see below).
OSM_BU_ID=HERE-THE-GUID-FOR-YOUR-BRIGADE

# Alternatively, override the full dashboard URL directly.
# Use this if the auto-built URL does not match your brigade's endpoint.
# DASHBOARD_URL=https://www.dashboardlive.nz/osm.php?bu={YOUR-GUID}

# How long (minutes) extracted data is cached before the next live fetch.
# Higher values reduce load on the OI server; lower values give fresher data.
# (default: 60)
SCRAPING_INTERVAL=60


# =============================================================================
# EMAIL  (SMTP)
# =============================================================================

# Email service name recognised by Nodemailer (e.g. gmail, outlook, yahoo).
# For custom SMTP servers use SMTP_HOST / SMTP_PORT instead (see Nodemailer docs).
SMTP_SERVICE=gmail

# The "from" address used when sending skill-expiry notifications.
SMTP_USER=sender@yourdomain.com

# App password or SMTP credential for the account above.
# For Gmail, generate an App Password in Google Account → Security → App passwords.
SMTP_PASS=your-app-password-here


# =============================================================================
# PROXY  (required for OI dashboard scraping from outside New Zealand)
# =============================================================================

# How the scraper sources a New Zealand IP address.
#   none     — scrape directly (only works if your server is already in NZ)
#   fixed    — always use the single proxy URL set in PROXY_URL below
#   dynamic  — automatically source and verify a working NZ proxy at startup
# (default: none)
PROXY_MODE=none

# Full proxy URL including credentials if required. Only used when PROXY_MODE=fixed.
# Example: http://user:pass@nz.proxy.provider.com:8888
# PROXY_URL=

# Override URL for the proxy list used in dynamic mode.
# Leave unset to use the built-in default source.
# DYNAMIC_PROXY_SOURCE=


# =============================================================================
# RATE LIMITING
# =============================================================================

# Login endpoint — protects against brute-force credential attacks.
# max: maximum attempts per window before the IP is blocked.
# windowMin: duration of the sliding window in minutes.
# (defaults: max=10, windowMin=15)
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MIN=15

# MFA code verification attempts.
# (defaults: max=5, windowMin=5)
RATE_LIMIT_MFA_MAX=5
RATE_LIMIT_MFA_WINDOW_MIN=5

# Forgot-password requests.
# (defaults: max=3, windowMin=30)
RATE_LIMIT_FORGOT_MAX=3
RATE_LIMIT_FORGOT_WINDOW_MIN=30

# General API requests — applies to all /api/* routes (authenticated).
# Does not cover the public live-form and survey submission endpoints.
# (defaults: max=300, windowMin=1)
RATE_LIMIT_API_MAX=300
RATE_LIMIT_API_WINDOW_MIN=1

# Public live-form access and survey submission endpoints (unauthenticated).
# These serve members who are not logged in; rate-limit per IP to deter abuse
# while allowing a whole crew to submit at once.
# (defaults: max=30, windowMin=5)
RATE_LIMIT_PUBLIC_SUBMIT_MAX=30
RATE_LIMIT_PUBLIC_SUBMIT_WINDOW_MIN=5


# =============================================================================
# UI CUSTOMISATION
# =============================================================================

# Name shown in the browser tab, login page, and notification emails.
UI_LOGIN_TITLE=OpReady

# Override the default logo image served from inside the container.
# Provide a URL path accessible by the browser, or a path inside the container.
# UI_LOGO_URL=

# Override the default login-page background image.
# UI_BACKGROUND_URL=

# Path to a local folder containing your custom logo.png and background.png.
# Mount this folder into the container and point this variable at the mount path.
# UI_RESOURCES_PATH=./my-custom-branding


# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# IANA timezone identifier used for all date calculations and display.
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# (default: Pacific/Auckland)
APP_TIMEZONE=Pacific/Auckland

# BCP 47 locale tag used for date/time formatting throughout the UI.
# (default: en-NZ)
APP_LOCALE=en-NZ

# Day of the week your brigade holds training. Used to highlight that day in
# the Training Planner calendar.
# Options: Monday | Tuesday | Wednesday | Thursday | Friday | Saturday | Sunday
TRAINING_DAY_OF_WEEK=Monday

# Number of days an 'Accepted' skill verification badge remains visible on the
# dashboard after an admin approves the form. (default: 30)
ACCEPTED_FORM_VISIBILITY_DAYS=30


# =============================================================================
# SKILL VERIFICATION — FORM SCORING DEFAULTS
# =============================================================================

# Minimum score an AI-evaluated form must achieve to be accepted. (default: 80)
DEFAULT_MIN_SCORE=80

# How the minimum score is interpreted.
#   percentage — score must be >= DEFAULT_MIN_SCORE % of the maximum possible
#   number     — score must be >= DEFAULT_MIN_SCORE raw points
DEFAULT_MIN_SCORE_TYPE=percentage

# Maximum number of submission attempts a member is allowed per form. (default: 1)
DEFAULT_MAX_TRIES=1


# =============================================================================
# AI EVALUATION  (optional)
# =============================================================================

# Enable automatic AI grading of free-text answers on skill verification forms.
# (default: false)
ENABLE_AI_EVALUATION=false

# AI provider to use for grading.
#   gemini — Google Gemini API (cloud; requires GEMINI_API_KEY)
#   ollama — Local Ollama instance (self-hosted; requires OLLAMA_BASE_URL)
AI_PROVIDER=gemini

# Model name passed to the selected provider.
# Gemini examples:  gemini-1.5-pro, gemini-1.5-flash
# Ollama examples:  llama3, qwen3:1.7b, mistral
AI_MODEL=gemini-1.5-pro

# API key for Google Gemini. Required when AI_PROVIDER=gemini.
GEMINI_API_KEY=your_gemini_api_key_here

# Base URL of your Ollama instance. Required when AI_PROVIDER=ollama.
# Use 'http://host.docker.internal:11434' when Ollama runs on the Docker host.
# (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434


# =============================================================================
# WHATSAPP  (optional)
# =============================================================================

# Enable the WhatsApp Web integration for skill-expiry notifications.
# On first start you must scan a QR code printed to the server console.
# The session is then persisted so subsequent restarts reconnect automatically.
# (default: false)
ENABLE_WHATSAPP=false


# =============================================================================
# PDF EXPORT  (Docker / self-hosted)
# =============================================================================

# Absolute path to the Chromium/Chrome binary used by Puppeteer to render
# compliance report PDFs. Leave unset to let Puppeteer use its bundled browser.
# In Docker, set this to the system Chromium installed in the image, e.g.: /usr/bin/chromium-browser
# PUPPETEER_EXECUTABLE_PATH=


# =============================================================================
# DATABASE
# =============================================================================

# Absolute path to the SQLite database file.
# Leave unset to use the default location: /app/fenz.db inside the container,
# or ./fenz.db when running locally.
# DB_PATH=/data/fenz.db


# =============================================================================
# KNOWLEDGE BASE DOCUMENT STORAGE
# =============================================================================

# Default number of days before a Knowledge Base document is flagged as expired.
# Expired documents remain accessible but are highlighted for admin review.
# (default: 365)
KB_DEFAULT_EXPIRY_DAYS=365

# Storage backend for Knowledge Base PDF documents.
#   local  — files stored on the server filesystem under KB_LOCAL_PATH (default)
#   s3     — files stored in an AWS S3 bucket (or any S3-compatible store)
#   gcs    — files stored in a Google Cloud Storage bucket
# (default: local)
KB_STORAGE_TYPE=local

# Path INSIDE the container where uploaded PDFs are stored (local mode only).
# In Docker the container path is fixed at /app/storage/knowledgebase — change the
# HOST path via KB_STORAGE_HOST_PATH below instead.
# (default: ./storage/knowledgebase resolved relative to the app root)
# KB_LOCAL_PATH=/app/storage/knowledgebase

# HOST path mounted into the container at /app/storage/knowledgebase (Docker only).
# docker-compose.yml reads this variable for its volume entry; it is not used by
# Node.js at runtime. Leave unset to use ./storage/knowledgebase in the project dir.
# Examples:
#   /mnt/nas/opready-kb      # external NAS
#   /data/kb                 # named host directory
# KB_STORAGE_HOST_PATH=

# Absolute path that constrains where remote backup files may be saved on disk.
# Remote backup save locations are validated against this root at configuration time.
# Leave unset to default to <app-dir>/backups.
# BACKUP_ROOT_DIR=

# HOST path mounted into the container at /app/backups (Docker only).
# docker-compose.yml reads this variable for its volume entry; it is not used by
# Node.js at runtime. Leave unset to use ./backups in the project dir.
# In the Backup & Restore UI, set the save location to /app/backups (the container path).
# Examples:
#   /mnt/nas/opready-backups     # external NAS
#   /data/backups                # named host directory
# BACKUP_HOST_PATH=

# AWS S3 — required when KB_STORAGE_TYPE=s3
# Optionally include a subfolder prefix: your-bucket-name/optional/prefix
# KB_S3_BUCKET=your-s3-bucket-name
# KB_S3_REGION=us-east-1
# KB_S3_ACCESS_KEY_ID=your-access-key-id
# KB_S3_SECRET_ACCESS_KEY=your-secret-access-key
# Optional: custom endpoint for S3-compatible stores (MinIO, Cloudflare R2, etc.)
# KB_S3_ENDPOINT=

# Google Cloud Storage — required when KB_STORAGE_TYPE=gcs
# Optionally include a subfolder prefix: your-bucket-name/optional/prefix
# KB_GCS_BUCKET=your-gcs-bucket-name
# Path to the GCS service-account key file (omit to use Application Default Credentials)
# KB_GCS_KEY_FILE=


# =============================================================================
# GOOGLE CLOUD STORAGE  (optional — GCS-hosted OI data source)
# =============================================================================

# Name of the GCS bucket that holds the exported OI dashboard HTML file.
# Required only when using a GCS-based scraping source instead of live scraping.
# GCS_BUCKET_NAME=your-gcs-bucket-name

# Filename of the OI dashboard export inside the bucket. (default: osm_dashboard_export.html)
# GCS_DATA_FILENAME=osm_dashboard_export.html
