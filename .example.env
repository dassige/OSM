# --- Application Secrets (PRODUCTION Only) ---
# These are used when APP_MODE=production (default)
APP_USERNAME=admin
APP_PASSWORD=your_secure_production_password
SESSION_SECRET=change_this_to_a_random_string
MAX_LOGIN_ATTEMPTS=5

# --- Application Secrets (DEMO Only) ---
# These are used ONLY when APP_MODE=demo
DEMO_SUPERADMIN_USERNAME=demo_admin
DEMO_SUPERADMIN_PASSWORD=demo_pass

# --- App Settings ---
# Operation Mode: 'production' (Live scraping), 'demo' (Local static file), or 'gcs' (Cloud Storage file)
APP_MODE=production

# Timezone for date calculations (Default: Pacific/Auckland)
APP_TIMEZONE=Pacific/Auckland
# Locale for date/time formatting (Default: en-NZ)
APP_LOCALE=en-NZ

# --- OSM Dashboard ---
# Option 1: Set the Business Unit ID (The URL will be built automatically)
OSM_BU_ID=HERE-THE-GUID-FOR-USER
# Option 2: Override the full URL manually (Legacy support)
# DASHBOARD_URL=https://www.dashboardlive.nz/osm.php?bu={YOUR-GUID}
SCRAPING_INTERVAL=60

# --- Email Configuration ---
SMTP_SERVICE=gmail
SMTP_USER=sender@yourdomain.com
SMTP_PASS=your-app-password-here

# --- Proxy Configuration ---
# Options: 'none', 'fixed', 'dynamic'
PROXY_MODE=dynamic
# REQUIRED if PROXY_MODE=fixed
# Example: http://user:pass@nz.proxy.provider.com:port
PROXY_URL=
# OPTIONAL for PROXY_MODE=dynamic
# (If you want to override the default ProxyScrape URL)
DYNAMIC_PROXY_SOURCE=

# --- UI Customization ---
UI_LOGIN_TITLE=Station 12 OpReady
# Leave these commented out to use the default files inside the container
# UI_LOGO_URL=
# UI_BACKGROUND_URL=

# Uncomment and 
# point to a local folder containing logo.png and background.png
# UI_RESOURCES_PATH=./my-custom-branding

# ---ONLY for Docker installation on Google Run--- UNCOMMENT the GCS_BUCKET_NAME and DB_PATH below and provide appropriate values
# Ensure this bucket exists and is accessible by your application
#GCS_BUCKET_NAME=your-gcs-bucket-name    
# Path to the SQLite database file 
#DB_PATH=/app/fenz.db
# Add the filename for the GCS scraping source if app_mode = gcs
#GCS_DATA_FILENAME=osm_dashboard_export.html


# --- WhatsApp Configuration ---
# Set to 'true' to enable WhatsApp Web integration.
# You will need to scan a QR code in the server console on startup.
ENABLE_WHATSAPP=false

# Day of the week for weekly training (Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, Sunday)
# Used for highlighting and filtering in the Training Planner.
TRAINING_DAY_OF_WEEK=Monday

# How many days an 'Accepted' icon remains visible on the dashboard
ACCEPTED_FORM_VISIBILITY_DAYS=30

# --- Forms Scoring Defaults ---
# Minimum score required to accept a form (default: 80)
DEFAULT_MIN_SCORE=70
# Type of minimum score ('percentage' or 'number')
DEFAULT_MIN_SCORE_TYPE=percentage 
# Maximum number of attempts allowed per form (default: 3)
DEFAULT_MAX_TRIES=3

# --- AI Evaluation Configuration ---
# Set to 'true' to enable AI-based paragraph grading
ENABLE_AI_EVALUATION=false
# Options: 'gemini' or 'ollama'
AI_PROVIDER=gemini
# Examples: 'gemini-1.5-pro' or 'llama3' (for Ollama)
AI_MODEL=gemini-1.5-pro
# Required if AI_PROVIDER=gemini
GEMINI_API_KEY=your_key_here
# Required if AI_PROVIDER=ollama (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434