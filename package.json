    "https-proxy-agent": "^5.0.1",
    "joi": "18.0.2",
    "jsdom": "^20.0.3",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.4",
    "path": "^0.12.7",
    "puppeteer-core": "^20.8.1",
    "qrcode": "^1.5.1",
