{
  "name": "fenz-osm",
  "version": "2.0.0",
  "description": "FENZ OSM Automation Manager",
  "versionDate": "2026/03/26 16:00",
  "author": "Gerardo Dassi",
  "repository": "https://github.com/dassige/OSM",
  "bugs": "https://github.com/dassige/OSM/issues",
  "homepage": "https://github.com/dassige/OSM",
  "license": "MIT",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "electron:dev": "electron electron-main.js",
    "electron:build": "electron-builder --win"
  },
  "build": {
    "appId": "com.fenz.osm.manager",
    "productName": "FENZ OSM Manager",
    "copyright": "Copyright © 2026 Gerardo Dassi",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build-res/FENZ.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "build-res/FENZ.ico",
      "uninstallerIcon": "build-res/FENZ.ico",
      "uninstallDisplayName": "FENZ OSM Manager"
    },
    "extraMetadata": {
      "main": "electron-main.js"
    },
    "files": [
      "**/*",
      "!dist-electron",
      "!Dockerfile",
      "!docker-compose.yml",
      "!litestream.yml",
      "!start.sh",
      "!.github",
      "!.git"
    ]
  },
  "dependencies": {
    "@google-cloud/storage": "^5.18.3",
    "@google/generative-ai": "^0.21.0",
    "axios": "^1.12.2",
    "cheerio": "^1.1.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "fs": "^0.0.1-security",
    "http": "^0.0.1-security",
    "https": "^1.0.0",
    "https-proxy-agent": "^5.0.1",
    "joi": "18.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.4",
    "path": "^0.12.7",
    "puppeteer-core": "^24.40.0",
    "qrcode": "^1.5.1",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "speakeasy": "^2.0.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "uuid": "^9.0.0",
    "whatsapp-web.js": "^1.20.3"
  },
  "devDependencies": {
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1"
  }
}