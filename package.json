  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:coverage": "jest --coverage --detectOpenHandles --forceExit",
    "test:ui": "playwright test",
    "test:api": "newman run examples/api/newman-smoke.postman_collection.json --environment examples/api/newman-environment.local.json",
    "test:api:report": "newman run examples/api/newman-smoke.postman_collection.json --environment examples/api/newman-environment.local.json --reporters cli,json --reporter-json-export newman-report.json",
    "test:all": "jest --detectOpenHandles --forceExit && playwright test",
    "screenshots": "node scripts/take-screenshots.js",
    "generate-demo-db": "node scripts/generate-demo-db.js",
    "setup-env": "node scripts/setup-env.js",
    "release": "node scripts/release.js",
    "build:setup-env": "node scripts/build-setup-env.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1061.0",
    "@google-cloud/storage": "^7.7.0",
