{
  "info": {
    "name": "OpReady API Smoke Tests",
    "_postman_id": "opready-api-smoke-v1",
    "description": "Read-only GET smoke tests for all OpReady API endpoints. Safe to run against any environment — no data is created or modified.\n\n**Setup:**\n1. Copy `newman-environment.example.json` to `newman-environment.local.json`.\n2. Set `baseUrl` to your target instance URL.\n3. Set `apiKey` to an admin-role API key from System Tools → API Key Management.\n4. Run: `npm run test:api`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key",   "value": "X-API-Key", "type": "string" },
      { "key": "value", "value": "{{apiKey}}", "type": "string" },
      { "key": "in",    "value": "header",     "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "apiKey",  "value": "",                      "type": "string" }
  ],
  "item": [

    {
      "name": "Connectivity",
      "description": "Public endpoints that require no authentication.",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "T20-01: Verifies the server is running and the database is connected."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('T20-01 | Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('T20-01 | Response time < 5s', () => pm.expect(pm.response.responseTime).to.be.below(5000));",
                  "pm.test('T20-01 | Valid JSON', () => pm.response.to.be.json);",
                  "pm.test('T20-01 | Status is ok', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('ok');",
                  "});",
                  "pm.test('T20-01 | DB is connected', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('db');",
                  "  pm.expect(body.db).to.eql('ok');",
                  "});",
                  "pm.test('T20-01 | Version is present', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('version');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness Probe",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/ready",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ready"]
            },
            "description": "T20-02: Verifies the server reports ready (DB connected, WhatsApp initialised if enabled)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('T20-02 | Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('T20-02 | Response time < 5s', () => pm.expect(pm.response.responseTime).to.be.below(5000));",
                  "pm.test('T20-02 | Valid JSON', () => pm.response.to.be.json);",
                  "pm.test('T20-02 | Status is ready', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('ready');",
                  "});",
                  "pm.test('T20-02 | DB is connected', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.db).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "API Docs (Swagger UI)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/docs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "docs"]
            },
            "description": "T20-03: Verifies the Swagger UI is served."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('T20-03 | Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('T20-03 | Response time < 5s', () => pm.expect(pm.response.responseTime).to.be.below(5000));"
                ]
              }
            }
          ]
        }
      ]
    },

    {
      "name": "Security",
      "description": "Verifies that authenticated endpoints reject unauthenticated requests.",
      "item": [
        {
          "name": "Unauthenticated access is rejected",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/members",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members"]
            },
            "description": "T20-03: Calls /api/members without any API key or session. Must return 401 or redirect — never member data."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('T20-03 | Unauthenticated request is rejected (401 or 302)', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([401, 302, 403]);",
                  "});",
                  "pm.test('T20-03 | Member data is not exposed', () => {",
                  "  if (pm.response.code === 200) {",
                  "    pm.expect.fail('Endpoint returned 200 without authentication — data is exposed!');",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },

