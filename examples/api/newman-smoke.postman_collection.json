                "type": "text/javascript",
                "exec": [
                  "pm.test('List Members | Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('List Members | Response time < 5s', () => pm.expect(pm.response.responseTime).to.be.below(5000));",
                  "pm.test('List Members | Returns an array', () => {",
                  "  pm.response.to.be.json;",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },

