    {
      "name": "Live Surveys (Public)",
      "description": "Public-facing survey endpoints — no authentication required for respondent access.",
      "item": [
        {
          "name": "Preview Survey (Admin)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/live-surveys/preview/:publicId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "live-surveys", "preview", ":publicId"],
              "variable": [{ "key": "publicId", "value": "your-public-id" }]
            }
          }
        },
        {
          "name": "Fetch Survey for Respondent",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/live-surveys/:accessCode",
              "host": ["{{baseUrl}}"],
              "path": ["api", "live-surveys", ":accessCode"],
              "variable": [{ "key": "accessCode", "value": "your-access-code" }]
            },
            "description": "Public endpoint — returns survey questions for a unique access code."
          }
        },
        {
          "name": "Submit Survey Response",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/live-surveys/:accessCode",
              "host": ["{{baseUrl}}"],
              "path": ["api", "live-surveys", ":accessCode"],
              "variable": [{ "key": "accessCode", "value": "your-access-code" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"q1\": \"Answer to question 1\",\n  \"q2\": \"Option A\"\n}"
            },
            "description": "Public endpoint — submits a respondent's answers."
          }
        }
      ]
    },

