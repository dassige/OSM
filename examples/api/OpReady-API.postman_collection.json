    {
      "name": "API Keys",
      "description": "Manage API keys for external integrations. Requires admin role.",
      "item": [
        {
          "name": "List API Keys",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/api-keys", "host": ["{{baseUrl}}"], "path": ["api", "api-keys"] },
            "description": "Returns all keys. The full key value is never returned — only the prefix for identification."
          }
        },
        {
          "name": "Create API Key",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/api-keys", "host": ["{{baseUrl}}"], "path": ["api", "api-keys"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"External Dashboard\",\n  \"role\": \"admin\"\n}"
            },
            "description": "Creates a new API key. `role` must be one of: `superadmin`, `admin`, `simple`, `guest`. The full key is returned **once** in the response — store it immediately."
          }
        },
        {
          "name": "Toggle API Key (Revoke / Enable)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/api-keys/:id/toggle",
              "host": ["{{baseUrl}}"],
              "path": ["api", "api-keys", ":id", "toggle"],
              "variable": [{ "key": "id", "value": "1" }]
            },
            "description": "Flips the active flag. A revoked key returns 401 on all subsequent requests."
          }
        },
        {
          "name": "Delete API Key",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/api-keys/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "api-keys", ":id"],
              "variable": [{ "key": "id", "value": "1" }]
            }
          }
        }
      ]
    },

