{
  "info": {
    "name": "OpReady API",
    "_postman_id": "opready-api-v1",
    "description": "REST API collection for the OpReady.\n\n**Authentication**\n\nTwo modes are supported:\n\n1. **API Key** (recommended for external integrations) — set the `apiKey` collection variable and all requests will include `X-API-Key` automatically.\n2. **Session Cookie** — use the `POST /login` request first; the session cookie is stored automatically by Postman.\n\n**Setup**\n1. Set the `baseUrl` variable to your instance URL (default: `http://localhost:3000`).\n2. Set the `apiKey` variable to a key generated in System Tools → API Key Management.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key",   "value": "X-API-Key", "type": "string" },
      { "key": "value", "value": "{{apiKey}}", "type": "string" },
      { "key": "in",    "value": "header",     "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "apiKey",  "value": "",                      "type": "string", "description": "Paste your API key here (generated in System Tools → API Key Management)" }
  ],
  "item": [

    {
      "name": "Auth",
      "description": "Login, MFA, logout, and session info.",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/login", "host": ["{{baseUrl}}"], "path": ["login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"your-password\"\n}"
            },
            "description": "Authenticates with email and password. If MFA is enabled, returns `mfaRequired: true` and you must follow up with POST /login/mfa."
          }
        },
        {
          "name": "Login - MFA",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/login/mfa", "host": ["{{baseUrl}}"], "path": ["login", "mfa"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"123456\"\n}"
            },
            "description": "Completes the MFA challenge after a login that returned `mfaRequired: true`."
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/forgot-password", "host": ["{{baseUrl}}"], "path": ["forgot-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            },
            "description": "Sends a password reset email if the account exists."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/logout", "host": ["{{baseUrl}}"], "path": ["logout"] },
            "description": "Destroys the current session and redirects to /login.html."
          }
        },
        {
          "name": "Get Session User",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/user-session", "host": ["{{baseUrl}}"], "path": ["api", "user-session"] },
            "description": "Returns the currently authenticated user's info and role."
          }
        }
      ]
    },

    {
      "name": "Members",
      "description": "Volunteer member management. Requires admin role.",
      "item": [
        {
          "name": "List Members",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/members", "host": ["{{baseUrl}}"], "path": ["api", "members"] },
            "description": "Returns all members as a plain array (no pagination params)."
          }
        },
        {
          "name": "List Members — Paginated",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/members?limit=25&offset=0&sortBy=name&sortDir=asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members"],
              "query": [
                { "key": "limit",   "value": "25" },
                { "key": "offset",  "value": "0" },
                { "key": "search",  "value": "", "disabled": true },
                { "key": "sortBy",  "value": "name" },
                { "key": "sortDir", "value": "asc" }
              ]
            },
            "description": "Returns `{ items, total, limit, offset }`. Add `search=<text>` to filter by member name."
          }
        },
        {
          "name": "Create Member",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/members", "host": ["{{baseUrl}}"], "path": ["api", "members"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Smith\",\n  \"email\": \"jane@station.nz\",\n  \"mobile\": \"0211234567\",\n  \"station\": \"Station 44\",\n  \"active\": 1\n}"
            }
          }
        },
        {
          "name": "Update Member",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/members/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members", ":id"],
              "variable": [{ "key": "id", "value": "1" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Smith\",\n  \"email\": \"jane@station.nz\",\n  \"mobile\": \"0211234567\",\n  \"station\": \"Station 44\",\n  \"active\": 1\n}"
            }
          }
        },
        {
          "name": "Delete Member",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/members/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members", ":id"],
              "variable": [{ "key": "id", "value": "1" }]
            }
          }
        },
        {
          "name": "Bulk Delete Members",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/members/bulk-delete", "host": ["{{baseUrl}}"], "path": ["api", "members", "bulk-delete"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": [1, 2, 3]\n}"
            }
          }
        },
        {
          "name": "Discover New Members",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/members/discover", "host": ["{{baseUrl}}"], "path": ["api", "members", "discover"] },
            "description": "Scrapes the external OI dashboard and returns member names not yet in the database."
          }
        },
        {
          "name": "Import Members",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/members/import", "host": ["{{baseUrl}}"], "path": ["api", "members", "import"] },
            "body": {
              "mode": "raw",
              "raw": "[\n  { \"name\": \"Alice\", \"email\": \"alice@station.nz\", \"mobile\": \"0211111111\", \"active\": 1 },\n  { \"name\": \"Bob\",   \"email\": \"bob@station.nz\",   \"mobile\": \"0212222222\", \"active\": 1 }\n]"
            }
          }
        }
      ]
    },

